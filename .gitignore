# Publish the trainer's production sources, artwork and documentation.
/*
!/.gitignore
!/README.md
!/src/
/src/**
!/src/**/
!/src/**/*.cs
!/src/Assets/kofi-support.png
!/docs/
/docs/*
!/docs/images/
/docs/images/*
!/docs/images/rarity-and-rolls.png
!/docs/images/run-and-time.png
!/docs/images/talents-and-marks.png
!/docs/images/auto-pick.png
!/docs/images/run-stats.png
!/scripts/
/scripts/*
!/scripts/build.ps1

# Generated output and local development files.
/build/
/.local/
**/tests/
**/*Tests.cs
**/SelfTest.cs

# Local contributor instructions must stay private.
AGENTS.md
**/AGENTS.md
